# ---- Joule MVP configuration ----
# Copy to .env and fill in. Every value has a sensible default.

PORT=3000

# Test the full pipeline with NO external calls and NO cost (synthesized answers).
# Set to false once you've added a real API key below.
DRY_RUN=true

# --- Upstream model provider (any OpenAI-compatible endpoint) ---
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Together:    https://api.together.xyz/v1
# Groq:        https://api.groq.com/openai/v1
# Local Ollama:http://localhost:11434/v1
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=

# The two models Joule routes between (small = cheap/low-carbon, large = capable)
MODEL_SMALL=gpt-4o-mini
MODEL_LARGE=gpt-4o

# Routing
ROUTING_ENABLED=true
COMPLEXITY_THRESHOLD=1
CACHE_TTL_MS=1800000

# --- Grid carbon intensity (Electricity Maps free tier) ---
# Get a free token: https://www.electricitymaps.com/free-tier
ELECTRICITYMAPS_TOKEN=
GRID_ZONE=AE
FALLBACK_INTENSITY=450

# --- Deployment mode & data residency (regional/compliance posture) ---
DEPLOYMENT_MODE=cloud         # "cloud" | "self_hosted"
DATA_REGION=AE                # where Joule runs / data is handled
PROVIDER_REGION=US            # where the upstream model endpoint lives (dashboard warns if != DATA_REGION)
LOG_PROMPTS=false             # default OFF: never persist prompt/response text (metadata only)
PII_REDACT=false              # redact emails/phones/long digit runs before logging

# --- Caching (Layer 1: exact + provider PREFIX caching; zero quality risk) ---
# Cached INPUT tokens cost this fraction of the input price; some providers charge
# a premium to WRITE the cache. Savings are reported NET of that write premium.
CACHE_READ_MULTIPLIER=0.5      # OpenAI 0.5; Anthropic ~0.1
CACHE_WRITE_MULTIPLIER=1.0     # OpenAI 1.0; Anthropic ~1.25
# CACHE_DRYRUN_PREFIX_RATE=0.5 # DRY_RUN only: synthetic cached-prefix fraction for demoing

# --- Cache Layer 2: SEMANTIC cache (OPT-IN, default OFF) ---
# Returns a similar (not identical) prompt's answer -> a GENUINE quality risk.
# Per-entry thresholds are learned to bound the realised error rate to the target;
# runs only on a Layer-1 miss; savings reported NET of embedding spend.
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_BASE_THRESHOLD=0.92  # conservative cosine start (raised automatically on errors)
SEMANTIC_CACHE_TARGET_ERROR=0.05    # bound on served-answer error rate
SEMANTIC_CACHE_VERIFY_RATE=0.25     # fraction of hits sampled to learn thresholds
SEMANTIC_CACHE_MAX_ENTRIES=500
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PRICE_PER_M=0.02          # USD per 1M embedding tokens (for net-of-embed accounting)
# Safety (semantic caching fails silently — these make it fail loudly):
SEMANTIC_CACHE_MIN_SIMILARITY=0.85  # hard floor; never serve below this whatever the target
SEMANTIC_CACHE_TTL=86400            # per-entry staleness cap in seconds (~24h)
SOURCE_VERSION=1                    # bump to invalidate ALL semantic entries (version-tagged keys)
SEMANTIC_CACHE_DISABLE_ERROR_RATE=0.15  # realised error above this auto-DISABLES the layer + alerts
SEMANTIC_CACHE_DISABLE_MIN_SAMPLES=20
SEMANTIC_CACHE_MAX_INPUT_CHARS=8000
# SEMANTIC_CACHE_BYPASS_PATTERNS=\bdiagnos\b,\binvoice\b   # extra sensitive-query patterns (regex, csv)
# Isolation headers: X-Joule-Tenant, X-Joule-Project, X-Joule-User-Tier ; bypass: X-Joule-Cache-Bypass

# --- Batch processing (savings-hierarchy #2; zero quality risk) ---
# Latency-tolerant work POSTed to /v1/batch is processed async at the provider
# batch discount. Same model, same output — just async and cheaper.
BATCH_DISCOUNT=0.5            # fraction off vs the sync price (OpenAI/Anthropic ~0.5)
BATCH_MAX_SIZE=1000           # max requests per batch submission

# --- Reasoning-budget control (savings-hierarchy #3, routing tier) ---
# Reasoning models (o-series, R1, extended-thinking Claude, Gemini thinking) emit
# 5-50x more tokens. Cap the thinking budget (low quality risk); optionally downgrade
# reasoning->standard for simple prompts (a quality-risk decision, verified).
REASONING_DEFAULT_EFFORT=medium      # low | medium | high (used when complexity is mid)
REASONING_MAX_THINKING_TOKENS=4000   # hard cap on the thinking budget
REASONING_DOWNGRADE_ENABLED=false    # downgrade reasoning->standard for simple prompts
REASONING_STANDARD_MODEL=gpt-4o-mini # target for downgrades
# Per-request override header:  X-Joule-Reasoning-Effort: low|medium|high

# --- Budget enforcement (metering REPORTS; enforcement PREVENTS) ---
# A request's cost is estimated + reserved BEFORE the model is called; if a cap
# would be exceeded and BUDGET_ENFORCE=true, the request is rejected (402) with no
# model call. Default is metering-only (breaches flagged, not blocked). 0 = no cap.
BUDGET_ENFORCE=false
BUDGET_GLOBAL_USD=0           # all-time cap
BUDGET_DAILY_USD=0            # per-day cap
BUDGET_SESSION_USD=0          # per X-Joule-Session cost cap (agent-run cap); breach TERMINATES the session
MAX_COST_PER_SESSION=0        # alias for BUDGET_SESSION_USD
MAX_CALLS_PER_SESSION=0       # per-session call cap; breach terminates the session
BUDGET_FAIL_MODE=fail_open    # fail_open (default: allow + log if the engine errors) | fail_closed
BUDGET_ASSUMED_COMPLETION_TOKENS=500  # reservation estimate for unknown completion length
# BUDGET_DEFS=[{"id":"team-a","scope":"session","key":"agent-x","limitUsd":5,"action":"block"}]
# Per-request hard cap via header:  X-Joule-Max-Cost: 0.01

# --- OpenTelemetry GenAI interop ---
# /metrics (Prometheus) is always on and dependency-free. OTLP/HTTP JSON span
# export is opt-in: point at a collector to emit a GenAI-convention span per request.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. http://localhost:4318  (spans POSTed to /v1/traces)
OTEL_SERVICE_NAME=joule

# --- ROI view ---
SUBSCRIPTION_COST_MONTHLY=0   # monthly subscription for net-of-fees + payback (0 => not shown)

# --- Quality verification (the differentiator): calibrated + conformal ---
# A cheap routing signal is calibrated (isotonic) to P(acceptable) and gated by a
# distribution-free conformal threshold; the LLM judge only LABELS calibration
# samples (off the serving path). Sampled, not exhaustive; the bound is MARGINAL,
# not per-query. In DRY_RUN the whole pipeline runs offline.
VERIFY_ENABLED=true
VERIFICATION_MODE=conformal   # "conformal" (calibrated gate) | "judge" (v1 fallback)
VERIFY_SAMPLE_RATE=0.1        # fraction of small answers sampled to LABEL for calibration
TARGET_RISK_ALPHA=0.05        # conformal bound on P(unacceptable | routed small)
MIN_CALIBRATION_N=50          # below this: refuse to state a guarantee, fall back
CALIBRATION_REFIT_EVERY=200   # refit isotonic every N new labels
JUDGE_MODELS=                 # csv panel of judge models (blank => the large model)
JUDGE_ACCEPT_THRESHOLD=0.6    # judge score >= this (and hard checks pass) => acceptable
JUDGE_AGREEMENT_THRESHOLD=0.67 # panel agreement below this => low-confidence, excluded
DRIFT_K=3                     # |live mean - cal mean| > K*calStd => drift warning + bias large
DRIFT_MIN_N=30               # min live samples before drift can trigger
# Adaptive conformal (Gibbs-Candes ACI): online self-correcting threshold under drift
CONFORMAL_MODE=adaptive       # "adaptive" (online alpha_t, default) | "static" (frozen full-set CRC)
ACI_GAMMA=0.01                # base learning rate for the alpha_t += gamma*(alpha - err) update
ACI_GAMMA_DRIFT=0.05          # boosted learning rate while drift is firing (faster re-convergence)
ACI_WINDOW=500                # rolling window (recent verified outcomes) the threshold is recomputed over
# v1 safety-mode fallback (used when not yet calibrated)
QUALITY_THRESHOLD=0.8
VERIFY_ROLLING_WINDOW=20
VERIFY_MIN_SAMPLES=3
VERIFY_PROBE_RATE=0.2
# VERIFY_FORCE_SCORE=0.9      # demo/test only: force the judge score (0..1); leave unset in prod
